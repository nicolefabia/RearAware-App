{
  "name": "rearaware-desktop",
  "version": "0.1.1",
  "description": "RearAware desktop app - detects and censors cat butts in your webcam feed via a virtual camera.",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rearaware.desktop",
    "productName": "RearAware",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine/dist/rearaware-engine",
        "to": "engine",
        "filter": ["**/*"]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "mac": {
      "icon": "../assets/icons/app-icon.icns",
      "category": "public.app-category.utilities",
      "target": ["dmg"],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "RearAware needs camera access to detect and censor cats in your webcam feed.",
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "../assets/icons/app-icon.ico",
      "target": ["nsis"]
    },
    "dmg": {
      "title": "RearAware"
    }
  }
}
