# Copy to .env (gitignored) for local development.
# Points the contribution-capture pipeline at rearaware.com's app-contribute
# route. Must match the REARAWARE_CONTRIBUTE_KEY set in that project's
# .env.local exactly - it's the shared secret the two sides authenticate with.
REARAWARE_CONTRIBUTE_URL=http://localhost:3000/api/app-contribute
REARAWARE_CONTRIBUTE_KEY=
