# Copy to .env (gitignored) for local development.
# Read by the Electron main process (src/main/contributions.js) when a photo
# is approved in the Review Photos window - the Python engine only captures
# crops locally now, it doesn't upload anything itself. Must match the
# REARAWARE_CONTRIBUTE_KEY set in rearaware.com's .env.local exactly - it's
# the shared secret the two sides authenticate with.
REARAWARE_CONTRIBUTE_URL=http://localhost:3000/api/app-contribute
REARAWARE_CONTRIBUTE_KEY=
